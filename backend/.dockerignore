# Secrets et environnements sensibles (AGENTS.md §2.4, NFR-1)
.env
.env.*
!.env.example
*.env
*.pem
*.key

# Contrôle de version et IDEs
.git
.gitignore
.DS_Store
.idea
.vscode

# Environnements virtuels
.venv
*/.venv
.python-version

